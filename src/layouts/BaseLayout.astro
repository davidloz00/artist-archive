---
import '../styles/global.css';
import '../styles/pattern-background.css';
import { withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  showHomeLink?: boolean;
}

const {
  title = "sid's studio",
  description = 'looking out the window',
  showHomeLink = true
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://sidwindow.studio').toString();
const previewImage = new URL(withBase('/images/sidwindow-cover.jpg'), 'https://sidwindow.studio').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eae4d8" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={previewImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">skip to content</a>
    <div class="site-shell">
      {showHomeLink && <a class="site-home-link mono" href={withBase('/')} aria-label="Return to home">sid's studio</a>}
      <div id="main-content">
        <slot />
      </div>
    </div>
  </body>
</html>
