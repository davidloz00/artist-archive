---
import BaseLayout from '../layouts/BaseLayout.astro';
import MainNav from '../components/MainNav.astro';
import { withBase } from '../lib/site';
---

<BaseLayout title="Artist Archive" showHomeLink={false}>
  <div class="page-wrap">
    <div class="paper-wash featured-art__wash" aria-hidden="true"></div>
    <div class="home-grid">
      <section class="home-intro">
        <h1 class="site-name">sid !!!</h1>
        <MainNav />
      </section>

      <section class="featured-art" aria-label="Featured artwork">
        <div class="featured-art__link">
          <img
            class="featured-art__image"
            src={withBase('/images/featured-artwork.png')}
            alt="Featured artwork"
            decoding="async"
          />
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
