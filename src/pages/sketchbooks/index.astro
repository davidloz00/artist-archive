---\nimport { getCollection } from 'astro:content';\nimport BaseLayout from '../../layouts/BaseLayout.astro';\nimport SketchbookViewer from '../../components/sketchbooks/SketchbookViewer.astro';\nimport { withBase } from '../../lib/site';\nimport '../../styles/sketchbooks.css';\nconst sketchbooks=await getCollection('sketchbooks');\nconst entries=[...sketchbooks].sort((a,b)=>(b.data.year??0)-(a.data.year??0));\nconst selectedId=Astro.url.searchParams.get('book');\nconst selected=selectedId?entries.find(e=>e.id===selectedId):undefined;\n---\n<BaseLayout title="Sketchbooks · sid !!!">\n<main class="sketchbooks-page">\n<a class="back-link" href={withBase('/')}>← home</a>\n{!selected?(<>\n<header class="sketchbooks-header"><p class="mono">archive / {entries.length}</p><h1>sketchbooks</h1><p>Working pages, studies, and notebooks kept close to hand.</p></header>\n<div class="sketchbooks-archive">{entries.map(entry=><a class="sketchbook-card" href={`${withBase('/sketchbooks/')}?book=${encodeURIComponent(entry.id)}`}><div class="sketchbook-card__cover">{entry.data.cover&&<img src={withBase(entry.data.cover)} alt={`${entry.data.title} cover`} />}</div><div class="sketchbook-card__meta"><h2>{entry.data.title}</h2><span class="mono">{entry.data.yearLabel??entry.data.year} · {entry.data.format}</span></div></a>)}</div>\n</>):(<>\n<a class="sketchbooks-back" href={withBase('/sketchbooks/')}>← all sketchbooks</a>\n{selected.data.video?<SketchbookViewer title={selected.data.title} yearLabel={selected.data.yearLabel??String(selected.data.year??'')} format={selected.data.format} description={selected.data.description} video={selected.data.video} favorites={selected.data.favoritePages}/>:<p>This sketchbook does not have a video yet.</p>}\n</>)}\n</main></BaseLayout>\n