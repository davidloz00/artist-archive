---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SketchbookViewer from '../../components/sketchbooks/SketchbookViewer.astro';
import { withBase } from '../../lib/site';
import '../../styles/sketchbooks.css';
const sketchbooks=await getCollection('sketchbooks');
const entries=[...sketchbooks].sort((a,b)=>(b.data.year??0)-(a.data.year??0));
const selectedId=Astro.url.searchParams.get('book');
const selected=selectedId?entries.find(e=>e.id===selectedId):undefined;
---
<BaseLayout title="Sketchbooks · sid !!!">
<main class="sketchbooks-page">
<a class="back-link" href={withBase('/')}>← home</a>
{!selected?(<>
<header class="sketchbooks-header"><p class="mono">archive / {entries.length}</p><h1>sketchbooks</h1><p>Working pages, studies, and notebooks kept close to hand.</p></header>
<div class="sketchbooks-archive">{entries.map(entry=><a class="sketchbook-card" href={`${withBase('/sketchbooks/')}?book=${encodeURIComponent(entry.id)}`}><div class="sketchbook-card__cover">{entry.data.cover&&<img src={withBase(entry.data.cover)} alt={`${entry.data.title} cover`} />}</div><div class="sketchbook-card__meta"><h2>{entry.data.title}</h2><span class="mono">{entry.data.yearLabel??entry.data.year} · {entry.data.format}</span></div></a>)}</div>
</>):(<>
<a class="sketchbooks-back" href={withBase('/sketchbooks/')}>← all sketchbooks</a>
{selected.data.video?<SketchbookViewer title={selected.data.title} yearLabel={selected.data.yearLabel??String(selected.data.year??'')} format={selected.data.format} description={selected.data.description} video={selected.data.video} favorites={selected.data.favoritePages}/>:<p>This sketchbook does not have a video yet.</p>}
</>)}
</main></BaseLayout>
