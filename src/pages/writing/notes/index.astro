---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../lib/site';
import { getCollection } from 'astro:content';

const monthOrder = ['january','february','march','april','may','june','july','august','september','october','november','december'];
const notes = await getCollection('notes');
const sortedNotes = [...notes].sort((a, b) => {
  const yearDiff = b.data.year - a.data.year;
  if (yearDiff) return yearDiff;
  return monthOrder.indexOf(b.data.month) - monthOrder.indexOf(a.data.month);
});
const contexts = [...new Set(sortedNotes.map((n) => n.data.context).filter(Boolean))].sort();
const years = [...new Set(sortedNotes.map((n) => n.data.year))].sort((a,b) => b-a);
---
<BaseLayout title="Notes App · sid !!!" description="Fragments, quotes, observations, things worth remembering.">
  <main class="notes-archive">
    <a class="back-link" href={withBase('/writing/')}>← writing</a>

    <header class="notes-archive__header">
      <div>
        <p class="mono">writing / 02</p>
        <h1>notes app</h1>
      </div>
      <p class="mono" id="note-count">{String(sortedNotes.length).padStart(2,'0')} notes</p>
    </header>

    <p class="notes-archive__intro">fragments, quotes, observations, things worth remembering</p>

    <div class="notes-tools">
      <label class="notes-search">
        <span class="mono">search</span>
        <input id="notes-search" type="search" placeholder="title, context, thought..." autocomplete="off" />
      </label>
      {contexts.length > 0 && (
        <div class="context-filters" aria-label="Filter notes by context">
          <button class="context-filter is-active" type="button" data-context="">all</button>
          {contexts.map((context) => <button class="context-filter" type="button" data-context={context}>{context}</button>)}
        </div>
      )}
    </div>

    <div class="notes-years">
      {years.map((year) => (
        <section class="notes-year" data-year-section>
          <h2 class="mono">{year}</h2>
          <div class="notes-list">
            {sortedNotes.filter((n) => n.data.year === year).map((note) => (
              <a
                class="note-row"
                href={withBase(`/writing/notes/${note.id}/`)}
                data-note
                data-title={note.data.title.toLowerCase()}
                data-context={(note.data.context ?? '').toLowerCase()}
              >
                <span class="note-row__title">{note.data.title}</span>
                {note.data.context && <span class="note-row__context">{note.data.context}</span>}
                <span class="note-row__date mono">{note.data.month.slice(0,3).toUpperCase()} {note.data.year}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
    <p class="notes-empty" id="notes-empty" hidden>nothing matched that.</p>
  </main>

  <script is:inline>
    (() => {
      const input = document.querySelector('#notes-search');
      const buttons = [...document.querySelectorAll('.context-filter')];
      const rows = [...document.querySelectorAll('[data-note]')];
      const sections = [...document.querySelectorAll('[data-year-section]')];
      const count = document.querySelector('#note-count');
      const empty = document.querySelector('#notes-empty');
      let context = '';

      function apply() {
        const q = (input?.value || '').trim().toLowerCase();
        let shown = 0;
        rows.forEach((row) => {
          const matchesContext = !context || row.dataset.context === context;
          const haystack = `${row.dataset.title} ${row.dataset.context} ${row.textContent}`.toLowerCase();
          const visible = matchesContext && (!q || haystack.includes(q));
          row.hidden = !visible;
          if (visible) shown++;
        });
        sections.forEach((section) => {
          section.hidden = !section.querySelector('[data-note]:not([hidden])');
        });
        if (count) count.textContent = `${String(shown).padStart(2,'0')} notes`;
        if (empty) empty.hidden = shown !== 0;
      }

      input?.addEventListener('input', apply);
      buttons.forEach((button) => button.addEventListener('click', () => {
        context = button.dataset.context || '';
        buttons.forEach((b) => b.classList.toggle('is-active', b === button));
        apply();
      }));
    })();
  </script>
</BaseLayout>

<style>
.notes-archive{width:min(100% - 2rem,980px);margin:0 auto;padding:clamp(2rem,5vw,5rem) 0 6rem}
.back-link{display:inline-block;margin-bottom:clamp(3rem,8vw,7rem)}
.notes-archive__header{display:flex;align-items:end;justify-content:space-between;gap:2rem;border-bottom:1px solid color-mix(in srgb,currentColor 18%,transparent);padding-bottom:1.25rem}
.notes-archive__header h1{margin:.2rem 0 0;font-family:var(--font-display);font-size:clamp(3.5rem,10vw,8rem);font-weight:400;line-height:.9}
.notes-archive__intro{max-width:34rem;margin:1.4rem 0 3rem;opacity:.7}
.notes-tools{display:grid;gap:1.2rem;margin-bottom:clamp(3rem,7vw,6rem)}
.notes-search{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:1rem;border-bottom:1px solid color-mix(in srgb,currentColor 18%,transparent);padding:.7rem 0}
.notes-search input{width:100%;border:0;background:transparent;color:inherit;font:inherit;outline:0}
.context-filters{display:flex;gap:.5rem;overflow-x:auto;padding-bottom:.3rem}
.context-filter{border:1px solid color-mix(in srgb,currentColor 16%,transparent);background:transparent;color:inherit;border-radius:999px;padding:.5rem .8rem;font:inherit;font-size:.78rem;opacity:.55;cursor:pointer;white-space:nowrap}
.context-filter.is-active,.context-filter:hover,.context-filter:focus-visible{opacity:1;border-color:var(--forest,currentColor)}
.notes-year{display:grid;grid-template-columns:minmax(5rem,10rem) 1fr;gap:2rem;padding:1.5rem 0 4rem;border-top:1px solid color-mix(in srgb,currentColor 12%,transparent)}
.notes-year h2{margin:.4rem 0 0;font-size:.78rem;font-weight:400}
.notes-list{display:grid}
.note-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(8rem,.45fr) auto;gap:1.5rem;align-items:baseline;min-height:3.5rem;padding:.9rem 0;border-bottom:1px solid color-mix(in srgb,currentColor 10%,transparent);text-decoration:none;transition:transform 180ms ease}
.note-row:hover,.note-row:focus-visible{transform:translateX(.35rem)}
.note-row__title{font-family:var(--font-display);font-size:clamp(1.4rem,3vw,2.1rem);line-height:1}
.note-row__context{font-size:.82rem;opacity:.42}
.note-row__date{font-size:.7rem;opacity:.55;white-space:nowrap}
.notes-empty{font-family:var(--font-display);font-size:2rem}
[hidden]{display:none!important}
@media(max-width:700px){.notes-archive__header{align-items:start;flex-direction:column;gap:1rem}.notes-year{grid-template-columns:1fr;gap:.75rem}.note-row{grid-template-columns:1fr auto;gap:.35rem 1rem}.note-row__context{grid-column:1/-1;grid-row:2}}
@media(prefers-reduced-motion:reduce){.note-row{transition:none}}
</style>
