---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../lib/site';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
const sortedNotes = [...notes].sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);

const grouped = sortedNotes.reduce((acc, note) => {
  const year = note.data.date?.getFullYear() ?? 'undated';
  (acc[year] ??= []).push(note);
  return acc;
}, {} as Record<string | number, typeof sortedNotes>);

const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---
<BaseLayout title="Notes App · sid !!!" description="Fragments, quotes, observations, things worth remembering.">
  <main class="notes-archive">
    <a class="back-link" href={withBase('/writing/')}>← writing</a>

    <header class="notes-archive__header">
      <div>
        <p class="mono">writing / 02</p>
        <h1>notes app</h1>
      </div>
      <p class="notes-archive__count mono">{String(sortedNotes.length).padStart(2, '0')} notes</p>
    </header>

    <p class="notes-archive__intro">
      fragments, quotes, observations, things worth remembering
    </p>

    {sortedNotes.length === 0 ? (
      <p class="notes-empty">nothing here yet.</p>
    ) : (
      <div class="notes-years">
        {years.map((year) => (
          <section class="notes-year" aria-labelledby={`notes-${year}`}>
            <h2 id={`notes-${year}`} class="mono">{year}</h2>

            <div class="notes-list">
              {grouped[year].map((note) => (
                <a class="note-row" href={withBase(`/writing/notes/${note.id}/`)}>
                  <span class="note-row__title">{note.data.title}</span>
                  {note.data.context && <span class="note-row__context">{note.data.context}</span>}
                  <time class="note-row__date mono" datetime={note.data.date?.toISOString()}>
                    {note.data.date
                      ? note.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
                      : ''}
                  </time>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .notes-archive {
    width: min(100% - 2rem, 980px);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 5rem) 0 6rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: clamp(3rem, 8vw, 7rem);
  }

  .notes-archive__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    padding-bottom: 1.25rem;
  }

  .notes-archive__header h1 {
    margin: .2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 8rem);
    font-weight: 400;
    line-height: .9;
  }

  .notes-archive__count {
    white-space: nowrap;
    padding-bottom: .4rem;
  }

  .notes-archive__intro {
    max-width: 34rem;
    margin: 1.4rem 0 clamp(4rem, 9vw, 8rem);
    opacity: .7;
  }

  .notes-year {
    display: grid;
    grid-template-columns: minmax(5rem, 10rem) 1fr;
    gap: 2rem;
    padding: 1.5rem 0 4rem;
    border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }

  .notes-year h2 {
    margin: .4rem 0 0;
    font-size: .78rem;
    font-weight: 400;
  }

  .notes-list {
    display: grid;
  }

  .note-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8rem, .45fr) auto;
    gap: 1.5rem;
    align-items: baseline;
    min-height: 3.5rem;
    padding: .9rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .note-row:hover,
  .note-row:focus-visible {
    transform: translateX(.35rem);
  }

  .note-row__title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    line-height: 1;
  }

  .note-row__context {
    font-size: .85rem;
    opacity: .58;
  }

  .note-row__date {
    font-size: .7rem;
    opacity: .55;
    white-space: nowrap;
  }

  .notes-empty {
    font-family: var(--font-display);
    font-size: 2rem;
  }

  @media (max-width: 700px) {
    .notes-archive__header {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
    }

    .notes-year {
      grid-template-columns: 1fr;
      gap: .75rem;
    }

    .note-row {
      grid-template-columns: 1fr auto;
      gap: .35rem 1rem;
    }

    .note-row__context {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-row {
      transition: none;
    }
  }
</style>
