---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../lib/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const monthOrder = ['january','february','march','april','may','june','july','august','september','october','november','december'];
const year = entry.data.year ?? entry.data.date?.getFullYear() ?? 0;
const month = entry.data.month ?? (entry.data.date ? monthOrder[entry.data.date.getMonth()] : 'january');
const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.title} · Notes App · sid !!!`} description={entry.data.title}>
  <main class="note-page">
    <a class="back-link" href={withBase('/writing/notes/')}>← notes app</a>
    <article class="note">
      <header class="note__header">
        <p class="mono">notes app / {month.toUpperCase()} {year}</p>
        <h1>{entry.data.title}</h1>
        {entry.data.context && (
          <a class="note__context" href={`${withBase('/writing/notes/')}?context=${encodeURIComponent(entry.data.context)}`}>
            {entry.data.context}
          </a>
        )}
      </header>
      <div class="note__body"><Content /></div>
    </article>
  </main>
</BaseLayout>
<style>
.note-page{width:min(100% - 2rem,920px);margin:0 auto;padding:clamp(2rem,5vw,5rem) 0 7rem}
.back-link{display:inline-block;margin-bottom:clamp(4rem,12vw,10rem)}
.note{width:min(100%,650px);margin:0 auto}
.note__header{margin-bottom:clamp(3rem,7vw,5.5rem)}
.note__header h1{margin:.65rem 0 1rem;font-family:var(--font-display);font-size:clamp(3rem,8vw,6.5rem);font-weight:400;line-height:.92}
.note__context{display:inline-block;color:inherit;font-size:.82rem;opacity:.42;text-decoration:none;border-bottom:1px solid transparent}
.note__context:hover,.note__context:focus-visible{opacity:.8;border-color:currentColor}
.note__body{font-size:clamp(1.05rem,2vw,1.22rem);line-height:1.8}
.note__body :global(p){margin:0 0 1.6em}
.note__body :global(blockquote){margin:2.5rem 0;padding-left:1.25rem;border-left:1px solid var(--forest,currentColor);font-family:var(--font-display);font-size:1.45em;line-height:1.35}
</style>
