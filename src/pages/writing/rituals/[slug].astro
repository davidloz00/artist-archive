---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { withBase } from '../../../../lib/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const rituals = await getCollection('rituals');
  const sorted = [...rituals].sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.id.localeCompare(b.id));

  return sorted.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      position: index,
      total: sorted.length,
      previous: sorted[index + 1] ?? null,
      next: sorted[index - 1] ?? null,
    },
  }));
}

const { entry, position, total, previous, next } = Astro.props;
const { Content } = await render(entry);
const previousUrl = previous ? withBase(`/writing/rituals/${previous.id}/`) : '';
const nextUrl = next ? withBase(`/writing/rituals/${next.id}/`) : '';
---

<BaseLayout title={`${entry.data.title} · Rituals · sid !!!`} description={entry.data.description ?? entry.data.title}>
  <main class="ritual-page">
    <a class="ritual-back mono" href={withBase('/writing/rituals/')}>← rituals</a>

    <article class="ritual-reader" aria-label={`Ritual ${position + 1} of ${total}`}>
      <header class="ritual-header">
        <p class="mono">rituals / {entry.data.year ?? ''}</p>
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="ritual-description">{entry.data.description}</p>}
      </header>

      <div class="ritual-content">
        <Content />
      </div>

      <nav class="ritual-nav" aria-label="Ritual navigation" data-previous-url={previousUrl} data-next-url={nextUrl}>
        {previous ? (
          <a class="ritual-nav__link" href={previousUrl}>
            <span class="mono">← previous</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : <span></span>}

        <span class="ritual-nav__count mono">{String(position + 1).padStart(2,'0')} / {String(total).padStart(2,'0')}</span>

        {next ? (
          <a class="ritual-nav__link ritual-nav__link--next" href={nextUrl}>
            <span class="mono">next →</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : <span></span>}
      </nav>
    </article>
  </main>

  <script is:inline>
    (() => {
      const nav = document.querySelector('.ritual-nav');
      if (!nav) return;

      const previousUrl = nav.getAttribute('data-previous-url') || '';
      const nextUrl = nav.getAttribute('data-next-url') || '';
      let startX = null;
      let startY = null;

      const go = (url) => {
        if (url) window.location.href = url;
      };

      document.addEventListener('keydown', (event) => {
        if (event.defaultPrevented) return;
        if (event.key === 'ArrowLeft') go(previousUrl);
        if (event.key === 'ArrowRight') go(nextUrl);
      });

      document.addEventListener('touchstart', (event) => {
        if (event.touches.length !== 1) return;
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
      }, { passive: true });

      document.addEventListener('touchend', (event) => {
        if (startX === null || startY === null || event.changedTouches.length !== 1) return;
        const endX = event.changedTouches[0].clientX;
        const endY = event.changedTouches[0].clientY;
        const dx = endX - startX;
        const dy = endY - startY;
        startX = null;
        startY = null;
        if (Math.abs(dx) < 60 || Math.abs(dx) <= Math.abs(dy) * 1.2) return;
        go(dx < 0 ? nextUrl : previousUrl);
      }, { passive: true });
    })();
  </script>
</BaseLayout>

<style>
  .ritual-page {
    width: min(100% - 2rem, 1000px);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 5rem) 0 6rem;
  }

  .ritual-back {
    display: inline-block;
    margin-bottom: clamp(4rem, 12vw, 9rem);
    text-decoration: none;
  }

  .ritual-reader {
    width: min(100%, 720px);
    margin: 0 auto;
  }

  .ritual-header {
    margin-bottom: clamp(4rem, 9vw, 8rem);
    text-align: center;
  }

  .ritual-header h1 {
    margin: .8rem 0 1.2rem;
    font-family: var(--font-display);
    font-size: clamp(4rem, 11vw, 9rem);
    font-weight: 400;
    line-height: .84;
    letter-spacing: -.025em;
  }

  .ritual-description {
    max-width: 30rem;
    margin: 0 auto;
    opacity: .52;
    font-size: .9rem;
  }

  .ritual-content {
    width: min(100%, 640px);
    margin: 0 auto;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.48rem);
    line-height: 1.72;
  }

  .ritual-content :global(p) {
    margin: 0 0 1.6em;
  }

  .ritual-content :global(h2),
  .ritual-content :global(h3) {
    margin: 3.5em 0 1em;
    font-weight: 400;
    line-height: 1;
  }

  .ritual-content :global(blockquote) {
    margin: 3rem 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--forest, currentColor);
    font-style: italic;
  }

  .ritual-content :global(em) {
    font-style: italic;
  }

  .ritual-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 3rem auto;
  }

  .ritual-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: end;
    margin-top: clamp(6rem, 13vw, 10rem);
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent);
  }

  .ritual-nav__link {
    display: grid;
    gap: .35rem;
    max-width: 14rem;
    color: inherit;
    text-decoration: none;
  }

  .ritual-nav__link strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.05;
  }

  .ritual-nav__link--next {
    justify-self: end;
    text-align: right;
  }

  .ritual-nav__link:hover strong,
  .ritual-nav__link:focus-visible strong {
    color: var(--forest, currentColor);
  }

  .ritual-nav__count {
    align-self: center;
    opacity: .42;
    font-size: .7rem;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .ritual-header h1 {
      font-size: clamp(3.2rem, 17vw, 6rem);
    }

    .ritual-content {
      font-size: 1.15rem;
      line-height: 1.68;
    }

    .ritual-nav__link {
      max-width: 8.5rem;
    }

    .ritual-nav__link strong {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ritual-content {
      scroll-behavior: auto;
    }
  }
</style>
