---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/site';
import { getCollection } from 'astro:content';

const [notes, rituals, essays] = await Promise.all([
  getCollection('notes'),
  getCollection('rituals'),
  getCollection('blog')
]);

const sortedNotes = [...notes].sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);

const sortedRituals = [...rituals].sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)
);

const sortedEssays = [...essays].sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
---

<BaseLayout
  title="Writing · sid !!!"
  description="Essays, Notes App, and Rituals."
>
  <div class="writing-page">
    <header class="writing-header">
      <p class="mono">writing</p>
      <h1>writing</h1>
    </header>

    <section
      class="writing-section writing-section--essays"
      aria-labelledby="essays-title"
    >
      <div>
        <p class="mono">01</p>
        <h2 id="essays-title">essays</h2>
        <p class="writing-kicker">longer pieces</p>
      </div>

      <div class="writing-list">
        <p class="writing-card__intro">available on substack</p>

        {sortedEssays.map((essay, index) => (
          <a
            class="writing-list__row writing-list__row--essay"
            href={essay.data.substackUrl ?? 'https://substack.com/'}
            target="_blank"
            rel="noreferrer"
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{essay.data.title}</strong>
            <small>
              {essay.data.date
                ? essay.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                  })
                : ''}
            </small>
          </a>
        ))}

        {sortedEssays.length === 0 && (
          <p class="writing-card__empty">available on substack</p>
        )}
      </div>
    </section>

    <section class="writing-section" aria-labelledby="notes-title">
      <div>
        <p class="mono">02</p>
        <h2 id="notes-title">
          <a href={withBase('/writing/notes/')}>notes app</a>
        </h2>
        <p class="writing-kicker">ideas or pieces</p>
      </div>

      <div class="writing-list">
        {sortedNotes.slice(0, 5).map((note, index) => (
          <a
            class="writing-list__row"
            href={withBase(`/writing/notes/${note.id}/`)}
          >
            <span>{String(sortedNotes.length - index).padStart(2, '0')}</span>
            <strong>{note.data.title}</strong>
            <small>
              {note.data.date
                ? note.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                  })
                : ''}
            </small>
          </a>
        ))}

        <a class="text-link" href={withBase('/writing/notes/')}>
          all notes →
        </a>
      </div>
    </section>

    <section class="writing-section" aria-labelledby="rituals-title">
      <div>
        <p class="mono">03</p>
        <h2 id="rituals-title">rituals</h2>
        <p class="writing-kicker">invented things</p>
      </div>

      <div class="writing-list">
        {sortedRituals.map((ritual, index) => (
          <a
            class="writing-list__row"
            href={withBase(`/writing/rituals/${ritual.id}/`)}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{ritual.data.title}</strong>
            <small>{ritual.data.year ?? ''}</small>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
