---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/site';

const entries = (await getCollection('artwork')).sort((a, b) => {
  const ad = a.data.date?.getTime() ?? 0;
  const bd = b.data.date?.getTime() ?? 0;
  return bd - ad;
});
---

<BaseLayout title="Artwork · Artist Archive" description="Finished pieces, studies, and things I decided to keep.">
  <main class="artwork-page">
    <a class="artwork-page__home" href={withBase('/')}>← home</a>

    <header class="artwork-header">
      <div>
        <p class="mono">archive / {entries.length}</p>
        <h1>artwork</h1>
      </div>

      <p class="artwork-header__intro">
        Finished pieces, studies, and things I decided to keep.
      </p>
    </header>

    <section class="artwork-grid" aria-label="Artwork archive">
      {entries.map((entry, index) => (
        <a class="artwork-card" href={withBase(`/artwork/${entry.id}/`)}>
          <div class="artwork-card__image">
            <img
              src={withBase(entry.data.image)}
              alt={entry.data.alt ?? entry.data.title}
              loading={index < 6 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>

          <div class="artwork-card__meta">
            <h2>{entry.data.title}</h2>

            <div class="artwork-card__details">
              {entry.data.year && <span>{entry.data.year}</span>}
              {entry.data.medium && <span>{entry.data.medium}</span>}
            </div>
          </div>
        </a>
      ))}
    </section>

    {entries.length === 0 && (
      <p class="artwork-empty">nothing here yet.</p>
    )}
  </main>
</BaseLayout>

<style>
  .artwork-page {
    width: min(100% - 2rem, 1280px);
    margin: 0 auto;
    padding: 1rem 0 7rem;
  }

  .artwork-page__home {
    display: inline-block;
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
    color: inherit;
    text-decoration: none;
  }

  .artwork-page__home:hover,
  .artwork-page__home:focus-visible {
    text-decoration: underline;
    text-underline-offset: .16em;
  }

  .artwork-header {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, .7fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
  }

  .artwork-header h1 {
    margin: .45rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 10vw, 9rem);
    font-weight: 400;
    line-height: .86;
    letter-spacing: -.04em;
  }

  .artwork-header__intro {
    max-width: 27rem;
    margin: 0;
    padding-bottom: .2rem;
    color: color-mix(in srgb, currentColor 62%, transparent);
    line-height: 1.45;
  }

  .artwork-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(3rem, 6vw, 6.5rem) clamp(1rem, 2.6vw, 2.75rem);
    padding-top: clamp(3.5rem, 6vw, 6rem);
  }

  .artwork-card {
    display: block;
    color: inherit;
    text-decoration: none;
    min-width: 0;
  }

  .artwork-card__image {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 25rem;
    padding: clamp(.5rem, 1.5vw, 1.5rem);
    background: color-mix(in srgb, currentColor 3%, transparent);
    overflow: hidden;
  }

  .artwork-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 34rem;
    object-fit: contain;
    transition: transform 220ms ease;
  }

  .artwork-card:hover .artwork-card__image img,
  .artwork-card:focus-visible .artwork-card__image img {
    transform: scale(1.015);
  }

  .artwork-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-top: .75rem;
  }

  .artwork-card__meta h2 {
    margin: 0;
    font-size: .92rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .artwork-card__details {
    display: flex;
    justify-content: flex-end;
    gap: .45rem;
    font-size: .62rem;
    letter-spacing: .03em;
    text-transform: lowercase;
    opacity: .48;
    white-space: nowrap;
  }

  .artwork-card__details span + span::before {
    content: '·';
    margin-right: .45rem;
  }

  .artwork-empty {
    margin-top: 4rem;
    color: color-mix(in srgb, currentColor 55%, transparent);
  }

  @media (max-width: 900px) {
    .artwork-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.25rem 1rem;
    }

    .artwork-card__image {
      min-height: 20rem;
    }
  }

  @media (max-width: 620px) {
    .artwork-page {
      width: min(100% - 1rem, 620px);
    }

    .artwork-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .artwork-header h1 {
      font-size: clamp(4rem, 18vw, 6rem);
    }

    .artwork-header__intro {
      max-width: 22rem;
    }

    .artwork-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem .65rem;
      padding-top: 2.5rem;
    }

    .artwork-card__image {
      min-height: 0;
      padding: .2rem;
    }

    .artwork-card__image img {
      max-height: 30rem;
    }

    .artwork-card__meta {
      display: block;
      padding-top: .55rem;
    }

    .artwork-card__details {
      justify-content: flex-start;
      margin-top: .25rem;
      white-space: normal;
    }
  }
</style>
