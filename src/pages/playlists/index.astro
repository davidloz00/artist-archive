---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/site';

const playlists = await getCollection('playlists');
const sorted = playlists.slice().sort((a, b) => {
  const yearDiff = (b.data.year ?? 0) - (a.data.year ?? 0);
  if (yearDiff !== 0) return yearDiff;
  return (b.data.number ?? 0) - (a.data.number ?? 0);
});

const years = [...new Set(sorted.map((item) => item.data.year).filter(Boolean))] as number[];
const tags = [...new Set(sorted.flatMap((item) => item.data.tags))].sort((a, b) => a.localeCompare(b));
const months = [...new Set(sorted.map((item) => item.data.month).filter(Boolean))].sort((a, b) => a!.localeCompare(b!));
const series = [...new Set(sorted.map((item) => item.data.series).filter(Boolean))] as string[];
const total = sorted.length;
---

<BaseLayout title="Playlists · Artist Archive" description="An Apple Music-first archive of playlists, liner notes, and stories.">
  <div class="playlists-page">
    <header class="playlists-header">
      <div>
        <span class="mono">music archive / {total}</span>
        <h1>playlists</h1>
        <p class="playlists-intro">An evolving collection of songs, situations, seasons, and memories.</p>
      </div>
      <button id="surprise-me" class="archive-button" type="button">surprise me <span aria-hidden="true">↗</span></button>
    </header>

    <section class="playlists-tools" aria-label="Playlist search and filters">
      <div class="playlist-search-wrap">
        <label class="search-field">
          <span class="sr-only">Search playlists</span>
          <input id="playlist-search" type="search" placeholder="search playlists..." autocomplete="off" />
        </label>
        <button id="clear-search" class="search-clear" type="button" hidden aria-label="Clear playlist search">clear</button>
      </div>

      <div class="playlist-filter-groups" aria-label="Playlist filters">
        <div class="playlist-filter-group">
          <p class="mono playlist-filter-label">series</p>
          <div class="playlist-filter-row" role="list" aria-label="Playlist series">
            <button class="filter-chip is-active" type="button" data-filter-kind="series" data-filter-value="all">all</button>
            {series.map((value) => (
              <button class="filter-chip" type="button" data-filter-kind="series" data-filter-value={value}>
                {value === 'monthly' ? 'monthly playlist' : value}
              </button>
            ))}
          </div>
        </div>

        <div class="playlist-filter-group">
          <p class="mono playlist-filter-label">month</p>
          <div class="playlist-filter-row" role="list" aria-label="Playlist months">
            <button class="filter-chip is-active" type="button" data-filter-kind="month" data-filter-value="all">all</button>
            {months.map((month) => <button class="filter-chip" type="button" data-filter-kind="month" data-filter-value={month}>{month}</button>)}
          </div>
        </div>

        <div class="playlist-filter-group">
          <p class="mono playlist-filter-label">mood / context</p>
          <div class="playlist-filter-row" role="list" aria-label="Playlist mood and context tags">
            <button class="filter-chip is-active" type="button" data-filter-kind="tag" data-filter-value="all">all</button>
            {tags.map((tag) => <button class="filter-chip" type="button" data-filter-kind="tag" data-filter-value={tag}>{tag}</button>)}
          </div>
        </div>
      </div>

      <p id="playlist-results" class="playlist-results mono" aria-live="polite">showing {total} of {total}</p>
    </section>

    <div id="playlist-empty" class="playlist-empty" hidden>
      Nothing here yet. Try another word, month, or mood.
    </div>

    <div class="playlist-archive" id="playlist-archive">
      {years.map((year) => {
        const yearItems = sorted.filter((item) => item.data.year === year);
        return (
          <section class="playlist-year" data-year={year}>
            <h2>{year}</h2>
            <div class="playlist-list">
              {yearItems.map((item) => {
                const number = item.data.number ? String(item.data.number).padStart(3, '0') : '—';
                const searchable = [
                  item.data.title,
                  item.data.whenToListen,
                  item.data.tags.join(' '),
                  item.data.series ?? '',
                  item.data.month ?? '',
                  item.body ?? ''
                ].join(' ').toLowerCase();
                return (
                  <a
                    class="playlist-row"
                    href={withBase(`/playlists/${item.id}/`)}
                    data-tags={item.data.tags.join('|')}
                    data-series={item.data.series ?? ''}
                    data-month={item.data.month ?? ''}
                    data-search={searchable}
                    data-url={withBase(`/playlists/${item.id}/`)}
                  >
                    <span class="mono playlist-row__number">{number}</span>
                    <span class="playlist-row__title-wrap">
                      <strong>{item.data.title}</strong>
                      <span class="playlist-row__listen">{item.data.whenToListen}</span>
                      {(item.data.series || item.data.month) && (
                        <span class="playlist-row__series mono">
                          {item.data.series === 'monthly' ? 'monthly playlist' : item.data.series}
                          {item.data.month ? ` · ${item.data.month}` : ''}
                        </span>
                      )}
                    </span>
                    <span class="playlist-row__arrow" aria-hidden="true">↗</span>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </div>

  <script>
    const search = document.querySelector('#playlist-search');
    const clearSearch = document.querySelector('#clear-search');
    const rows = [...document.querySelectorAll('.playlist-row')];
    const yearSections = [...document.querySelectorAll('.playlist-year')];
    const empty = document.querySelector('#playlist-empty');
    const chips = [...document.querySelectorAll('.filter-chip')];
    const surprise = document.querySelector('#surprise-me');
    const results = document.querySelector('#playlist-results');

    const activeFilters = {
      series: 'all',
      month: 'all',
      tag: 'all'
    };

    const applyFilters = () => {
      const query = (search?.value || '').trim().toLowerCase();
      let visible = 0;

      rows.forEach((row) => {
        const haystack = row.dataset.search || '';
        const tags = (row.dataset.tags || '').split('|').filter(Boolean);
        const matchesSearch = !query || haystack.includes(query);
        const matchesSeries = activeFilters.series === 'all' || (row.dataset.series || '') === activeFilters.series;
        const matchesMonth = activeFilters.month === 'all' || (row.dataset.month || '') === activeFilters.month;
        const matchesTag = activeFilters.tag === 'all' || tags.includes(activeFilters.tag);
        const show = matchesSearch && matchesSeries && matchesMonth && matchesTag;
        row.hidden = !show;
        if (show) visible += 1;
      });

      yearSections.forEach((section) => {
        const anyVisible = [...section.querySelectorAll('.playlist-row')].some((row) => !row.hidden);
        section.hidden = !anyVisible;
      });

      if (empty) empty.hidden = visible !== 0;
      if (results) results.textContent = `showing ${visible} of ${rows.length}`;
      if (clearSearch) clearSearch.hidden = !query;
    };

    search?.addEventListener('input', applyFilters);

    clearSearch?.addEventListener('click', () => {
      if (!search) return;
      search.value = '';
      search.focus();
      applyFilters();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const kind = chip.dataset.filterKind || 'tag';
        const value = chip.dataset.filterValue || 'all';
        activeFilters[kind] = value;

        chips
          .filter((item) => item.dataset.filterKind === kind)
          .forEach((item) => item.classList.toggle('is-active', item === chip));

        applyFilters();
      });
    });

    surprise?.addEventListener('click', () => {
      const visibleRows = rows.filter((row) => !row.hidden);
      const pool = visibleRows.length ? visibleRows : rows;
      const target = pool[Math.floor(Math.random() * pool.length)];
      const url = target?.dataset.url;
      if (url) window.location.href = url;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== search) {
        event.preventDefault();
        search?.focus();
      }
      if (event.key === 'Escape' && document.activeElement === search && search?.value) {
        search.value = '';
        applyFilters();
      }
    });

    const params = new URLSearchParams(window.location.search);
    const initialTag = params.get('tag');
    const initialSeries = params.get('series');
    const initialMonth = params.get('month');

    if (initialSeries) {
      const chip = chips.find((item) => item.dataset.filterKind === 'series' && item.dataset.filterValue === initialSeries);
      if (chip) chip.click();
    }
    if (initialMonth) {
      const chip = chips.find((item) => item.dataset.filterKind === 'month' && item.dataset.filterValue === initialMonth);
      if (chip) chip.click();
    }
    if (initialTag) {
      const chip = chips.find((item) => item.dataset.filterKind === 'tag' && item.dataset.filterValue === initialTag);
      if (chip) chip.click();
    }

    applyFilters();
  </script>

  <style>
    .playlist-filter-groups { display: grid; gap: 1.25rem; }
    .playlist-filter-group { display: grid; gap: .45rem; }
    .playlist-filter-label { margin: 0; color: var(--warm-gray); text-transform: uppercase; letter-spacing: .08em; font-size: .62rem; }
    .playlist-search-wrap { display: flex; align-items: end; gap: 1rem; max-width: 40rem; }
    .playlist-search-wrap .search-field { flex: 1; max-width: none; }
    .search-clear {
      min-width: auto;
      min-height: 44px;
      border: 0;
      border-bottom: 1px solid var(--line);
      padding: .6rem 0 .75rem;
      background: transparent;
      color: var(--warm-gray);
      cursor: pointer;
      font-family: var(--mono);
      font-size: .64rem;
      letter-spacing: .07em;
      text-transform: uppercase;
    }
    .search-clear:hover,
    .search-clear:focus-visible { color: var(--forest); outline: none; }
    .playlist-results { margin: .85rem 0 0; color: var(--warm-gray); }
    .playlist-row__series { display: block; margin-top: .35rem; color: var(--warm-gray); font-size: .6rem; letter-spacing: .08em; text-transform: uppercase; }
  </style>
</BaseLayout>
